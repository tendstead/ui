{
  "name": "@tendstead/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "npm run build:package && svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run build:package && npm run build:demo",
    "test": "npm run test:unit && npm run test:browser",
    "build:package": "svelte-package -i src/lib -o dist",
    "build:demo": "vite build",
    "test:unit": "vitest run",
    "test:browser": "playwright test --project=chromium --project=firefox --project=webkit",
    "preview": "vite preview --host 0.0.0.0",
    "watch:package": "svelte-package -i src/lib -o dist --watch",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots=all",
    "test:consumer": "node scripts/consumer-smoke.mjs",
    "verify": "npm run check && npm run build && npm run test:unit && npm run test:consumer && npm run test:browser && npm run test:visual"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "svelte": "^5.20.0"
  },
  "dependencies": {
    "@melt-ui/svelte": "0.86.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lucide/svelte": "1.67.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
